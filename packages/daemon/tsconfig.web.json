{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "outDir": "./dist-types/web",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [{ "path": "../shared" }, { "path": "./tsconfig.ipc.json" }],
  "include": ["src/renderer/**/*.ts", "src/renderer/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.spec.ts", "out", "dist", "dist-types"]
}
