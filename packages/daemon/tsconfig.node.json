{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "outDir": "./dist-types/node",
    "noEmit": false,
    "emitDeclarationOnly": true
  },
  "references": [{ "path": "../shared" }, { "path": "./tsconfig.ipc.json" }],
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "out",
    "dist",
    "dist-types"
  ]
}
