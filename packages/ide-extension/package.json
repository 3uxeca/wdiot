{
  "name": "wdiot-ide-extension",
  "displayName": "WDIOT IDE Reporter",
  "description": "Reports Cursor/VSCode file activity to the WDIOT daemon",
  "version": "0.1.0",
  "private": true,
  "publisher": "soslab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wdiot.showStatus",
        "title": "WDIOT: 수집 상태 보기"
      }
    ]
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.json",
    "watch": "tsc -w -p ./tsconfig.json",
    "package": "vsce package --no-dependencies --allow-missing-repository --out wdiot-ide-extension-0.1.0.vsix",
    "clean": "rm -rf out *.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.1"
  }
}
